0.45895, "هُوَ الَّذِي جَعَلَ لَكُمُ الْأَرْضَ ذَلُولًا فَامْشُوا فِي مَنَاكِبِهِ", 155.0, false, 154.92, "هُوَ الَّذِي جَعَلَ لَكُمُ الْأَرْضَ ذَلُولًا فَامْشُوا فِي مَنَاكِبِهِ"], [0.46265, "مناكبها وكلوا من رزقه وإليه النشور", 160.0, false, 159.44, "منكبها وكلوا من رزقه وإليه النشور"], [0.46121, "أَأَمِنْتُمْ مَنْ فِي السَّمَاءِ", 165.0, false, 163.8, "أَأَمِنْتُمْ مَنْ فِي السَّمّ"], [0.41575, "إِلَى أَنْ يَخْسِفَ بِكُمُ الْأَرْضَ فَإِذَا هِيَ تَمُورُ", 170.0, false, 169.92, "إِلََّاءِ أَنْ يَخْسِفَ بِكُمُ الْأَرْضَ فَإِذَا هِيَ تَمُورُ"], [0.47255, "أَمْ أَمِنْتُمْ مَنْ فِي السَّمَاءِ أَنْ يُرْسِلُوا", 175.0, false, 175.0, "أَمْ أَمِنْتُمْ مَنْ فِي السَّمَاءِ أَنْ يُرْسِلَاءِ"], [0.4526, "أَنْ يُرْسِلَ عَلَيْكُمْ حَاصِبًا فَسَتَعْلَمُونَ كَيْفَ نَذِيرِ", 180.0, false, 179.92, "أَنْ يُرْسِلَ عَلَيْكُمْ حَاصِبًا فَسَتَعْلَمُونَ كَيْفَ نَذِيرِ"], [0.45806, "وَلَقَدْ كَذَّبَ الَّذِينَ مِنْ قَبْلِهِ", 185.0, false, 184.76, "وَلَقَدْ كَذَّبَ الَّذِينَ مِنْ قَبْلِهِمْ"], [0.49941, "فَكَيْفَ كَانَ نَكِيرِ", 190.0, false, 188.48, "مِنْ قَبِْهِمْ فَكَيْفَ كَانَ نَكرِ"], [0.4679, "أَوَلَمْ يَرَوْا إِلَى الطَّيْرِ فَوْقَهُمْ صَ", 195.0, false, 194.28, "أولَلَمْ يَرَْا إلى الطَّيْرِ فَوْقَهُمْ ص"], [0.47075, "", 200.0, false, null, "افاتٍ ويَقْبِضْنَكنَّ"], [0.47015, "مَا يُمْسِكُهُنَّ إِلَّا الرَّحْمَنُ إِنَّهُ", 205.0, false, 204.04, "مَا يُمْسِكُهُنَّ إِلَّا الرَّحْمَنُ إِنَّهُ"], [0.50097, "إِنَّهُ بِكُلِّ شَيْءٍ بَصِيرٌ أَمَّنْ هَذَا الَّذِي", 210.0, false, 209.84, "إِنَّهُ بِكُلِّ شَيْءٍ بَصِيرٌ أَمَّنْ هَذَا الَّذِي"], [0.5143, "هَذَا الَّذِي هُوَ جُنْدٌ لَكُمْ يَنْصُرُكُمْ", 215.0, false, 213.72, "هَذَا الَّذِي هُوَ جُنْدٌ لَكُمْ يَنْصُرُكُمْ"], [0.4747, "مِنْ دُونِ الرَّحْمَنِ إِنِ الْكَافِرُونَ إِلَّا", 220.0, false, 219.6, "مِنْ دُونِ الرَّحْمَنِ إِنِ الْكَافِرُونَ إِلَّ"], [0.48188, "إِلَّا فِي غُرُورٍ أَمَّنْ هَذَا", 225.0, false, 223.8, "يَُونَ إِلَّا فِي غُرُورٍ أَمَّنْ هَذَاَى"], [0.45425, "قُلْ هُوَ الَّذِي يَرْزُقُكُمْ إِنْ أَمْسَكَ رِزْقَهُ بَلْ لَجُّوا ف