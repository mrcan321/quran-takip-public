# --- Konfigürasyon ---
SAMPLE_RATE = 16000
CHUNK_DURATION_SEC = 4.0          # 3 → 4: daha fazla kelime, daha güvenli match
OVERLAP_DURATION_SEC = 0.7        # 0.5 → 0.7: kelime sınırı koruması
CHUNK_SAMPLES = int(SAMPLE_RATE * CHUNK_DURATION_SEC)
OVERLAP_SAMPLES = int(SAMPLE_RATE * OVERLAP_DURATION_SEC)

# Ses enerjisi eşiği — bundan düşükse ASR'ye bile gönderme
MIN_RMS_ENERGY = 0.005            # ~-46 dBFS
# Minimum transkripsiyon uzunluğu — tek kelime Kuran'da onlarca yerde geçer
MIN_WORD_COUNT = 3
# Güven eşiği
MIN_CONFIDENCE = 50               # 40 → 50: daha katı

# Preferred range — son eşleşmeden kaç kelime ileri/geriye bak
PREFERRED_WINDOW = 60             # son pozisyondan +60 kelime (yaklaşık 3-5 ayet)
PREFERRED_BONUS = 30              # bu bölgedeki eşleşmelere +20 puan
PREFERRED_BACKWARD_TOLERANCE = 0
# Ardışık kaç chunk kayıp olunca pozisyonu sıfırla
RESET_AFTER_LOST_CHUNKS = 3
MAX_GAP_FILL = 3

