@sock.route("/audio")
def audio_ws(ws):
    print(f"[WS] Bağlantı: {request.remote_addr}")

    session_id = str(int(time.time()))
    session_path = RECORDINGS_DIR / f"session_{session_id}.wav"
    state = SessionState()

    full_audio = []
    chunk_buffer = []
    chunk_buffer_samples = 0
    chunk_index = 0
    overlap_tail = np.array([], dtype=np.float32)

    try:
        while True:
            msg = ws.receive()
            if msg is None:
                break

            if isinstance(msg, str):
                try:
                    data = json.loads(msg)
                    if data.get("type") == "stop":
                        break
                except json.JSONDecodeError:
                    pass
                continue

            if not isinstance(msg, bytes):
                continue

            audio_np = np.frombuffer(msg, dtype=np.float32)
            full_audio.append(audio_np)
            chunk_buffer.append(audio_np)
            chunk_buffer_samples += len(audio_np)

            if chunk_buffer_samples >= CHUNK_SAMPLES:
                current = np.concatenate([overlap_tail] + chunk_buffer)
                process_len = min(len(current), CHUNK_SAMPLES + OVERLAP_SAMPLES)
                to_process = current[:process_len]

                overlap_tail = current[CHUNK_SAMPLES - OVERLAP_SAMPLES:CHUNK_SAMPLES]

                result = process_chunk(to_process, chunk_index, state)
                ws.send(json.dumps(result, ensure_ascii=False))

                # Terminal log
                if result["status"] == "matched":
                    v = result["verses"]
                    summary = ", ".join(
                        f"{x['surah_name_tr']} {x['surah']}:{x['ayah']}"
                        for x in v
                    )
                    pref_tag = " [tercihli]" if result.get("in_preferred") else ""
                    gap_tag = f" [+{result['gap_filled']} ara]" if result.get("gap_filled") else ""
                    print(f"[chunk {chunk_index}] ✓ {summary} "
                          f"(güven {result['confidence']}, {result['asr_time']}sn){pref_tag}{gap_tag}")    
            else:
                    extra = ""
                    if result.get("state_reset"):
                        extra = " [STATE RESET]"
                    text_preview = result.get('text', '')[:30]
                    print(f"[chunk {chunk_index}] ⊘ {result['status']}"
                          f"{' | ' + text_preview if text_preview else ''}{extra}")

                chunk_index += 1
                chunk_buffer = []
                chunk_buffer_samples = 0

    except Exception as e:
        import traceback
        print(f"[WS] Hata: {e}")
        traceback.print_exc()

    finally:
        if full_audio:
            full = np.concatenate(full_audio)
            sf.write(str(session_path), full, SAMPLE_RATE)
            duration = len(full) / SAMPLE_RATE
            print(f"[WS] Oturum: {session_path.name} ({duration:.1f}sn, "
                  f"{state.matched_chunks}/{state.total_chunks} chunk matched)")


