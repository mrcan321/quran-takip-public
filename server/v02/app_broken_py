@dataclass
class SessionState:
    """Bir WebSocket oturumunun hafızası."""
    last_word_index: Optional[int] = None      # Kuran korpusunda son pozisyon
    last_surah: Optional[int] = None
    last_ayah: Optional[int] = None
    lost_chunks: int = 0                        # ardışık başarısız chunk sayısı
    total_chunks: int = 0
    matched_chunks: int = 0


def compute_rms(audio_np: np.ndarray) -> float:
    """Ses enerjisi (RMS) — 0-1 arası."""
    if len(audio_np) == 0:
        return 0.0
    return float(np.sqrt(np.mean(audio_np ** 2)))


def transcribe_chunk(audio_np: np.ndarray) -> str:
    import tempfile
    with tempfile.NamedTemporaryFile(suffix=".wav", delete=False) as tmp:
        sf.write(tmp.name, audio_np, SAMPLE_RATE)
        tmp_path = tmp.name

    try:
        output = ASR_MODEL.transcribe([tmp_path], verbose=False)
    finally:
        Path(tmp_path).unlink(missing_ok=True)

    if output and hasattr(output[0], "text"):
        return output[0].text.strip()
    if output and isinstance(output[0], str):
        return output[0].strip()
    if output and isinstance(output[0], list) and output[0]:
        first = output[0][0]
        return (first.text if hasattr(first, "text") else str(first)).strip()
    return ""


def score_transcription(text: str, match) -> Tuple[float, dict]:
    tokens = [normalize_arabic(t) for t in text.split()]
    tokens = [t for t in tokens if t]
    if not tokens:
        return 0.0, {"reason": "boş", "word_count": 0}

    fuzzy = match.score if match else 0
    in_vocab = sum(1 for t in tokens if t in CORPUS_VOCAB)
    vocab_coverage = in_vocab / len(tokens)
    unique_ratio = len(set(tokens)) / len(tokens)

    max_consec = 1
    c = 1
    for i in range(1, len(tokens)):
        if tokens[i] == tokens[i - 1]:
            c += 1
            max_consec = max(max_consec, c)
        else:
            c = 1

    score = fuzzy * (vocab_coverage ** 0.5) * (unique_ratio ** 0.3)
    reason = ""
    if max_consec >= 3:
        score *= 0.3
        reason = f"{max_consec}x tekrar"
    if vocab_coverage < 0.3:
        score *= 0.5
        reason = reason or f"vocab düşük ({vocab_coverage:.0%})"

    return round(score, 1), {
        "fuzzy": fuzzy,
        "vocab_coverage": round(vocab_coverage, 2),
        "word_count": len(tokens),
        "reason": reason,
    }


def get_surah_info(surah_num: int) -> dict:
    """Sure metadata — Türkçe + Arapça."""
    info = SURAH_NAMES.get(str(surah_num), {})
    return {
        "number": surah_num,
        "name_tr": info.get("turkish", f"Sure {surah_num}"),
        "name_ar": info.get("arabic", ""),
        "name_en": info.get("english", ""),
    }


def collect_verses(start_idx: int, end_idx: int):
    seen = set()
    verses = []
    for i in range(start_idx, end_idx + 1):
        w = CORPUS.words[i]
        key = (w.surah, w.ayah)
        if key not in seen:
            seen.add(key)
            verses.append(key)
    return verses


def build_verse_payload(surah: int, ayah: int):
    arabic_words = [
        w.text for w in CORPUS.words
        if w.surah == surah and w.ayah == ayah
    ]
    arabic = " ".join(arabic_words)
    meal = MEALS.get(f"{surah}:{ayah}", "")
    surah_info = get_surah_info(surah)
    return {
        "surah": surah,
        "ayah": ayah,
        "surah_name_tr": surah_info["name_tr"],
        "surah_name_ar": surah_info["name_ar"],
        "arabic": arabic,
        "meal": meal,
    }


def process_chunk(audio_np, chunk_index, state: SessionState):
    """Ana chunk işleme fonksiyonu — session state kullanır."""
    state.total_chunks += 1

    result = {
        "type": "chunk",
        "index": chunk_index,
    }

    # Adım 1: Ses enerjisi kontrolü
    rms = compute_rms(audio_np)
    result["rms"] = round(rms, 4)

    if rms < MIN_RMS_ENERGY:
        result["status"] = "silent"
        result["reason"] = f"sessiz (RMS={rms:.4f})"
        return result

    # Adım 2: Transkripsiyon
    t0 = time.time()
    text = transcribe_chunk(audio_np)
    result["asr_time"] = round(time.time() - t0, 2)
    result["text"] = text

    if not text:
        result["status"] = "empty"
        state.lost_chunks += 1
        return result

    # Adım 3: Minimum kelime kontrolü
    tokens = [normalize_arabic(t) for t in text.split() if t]
    word_count = len([t for t in tokens if t])
    if word_count < MIN_WORD_COUNT:
        result["status"] = "too_short"
        result["reason"] = f"{word_count} kelime (min {MIN_WORD_COUNT})"
        state.lost_chunks += 1
        return result

    # Adım 4: Preferred range hesapla
    preferred_range = None
    if state.last_word_index is not None:
        # Geriye gitme yasak — namazda imam hep ileri okur
        preferred_range = (
            state.last_word_index,
            state.last_word_index + PREFERRED_WINDOW,
        )
    # Adım 5: Hizalama (preferred_range ile)
    match = align_transcription(
        text, CORPUS,
        preferred_range=preferred_range,
        preferred_bonus=PREFERRED_BONUS,
    )
    score, score_details = score_transcription(text, match)
    result["confidence"] = score
    result["word_count"] = score_details["word_count"]

    # Preferred_range içinde mi?
    in_preferred = False
    if match and preferred_range:
        ps, pe = preferred_range
        if ps <= match.start_word_idx <= pe:
            in_preferred = True
    result["in_preferred"] = in_preferred

    if score < MIN_CONFIDENCE or not match:
        result["status"] = "low_confidence"
        result["reason"] = score_details.get("reason") or f"skor {score}"
        state.lost_chunks += 1
        # Çok fazla ardışık kayıp varsa state'i sıfırla
        if state.lost_chunks >= RESET_AFTER_LOST_CHUNKS:
            state.last_word_index = None
            state.last_surah = None
            state.last_ayah = None
            result["state_reset"] = True
        return result

    # Başarılı eşleşme
# Başarılı eşleşme
    verses = collect_verses(match.start_word_idx, match.end_word_idx)

    # ARAYI DOLDURMA: son gösterilen ayet ile yeni ayet arasında boşluk varsa doldur
    if verses and state.last_surah is not None and state.last_ayah is not None:
        first_surah, first_ayah = verses[0]
        # Sadece aynı sure içinde boşluk doldur (farklı sureye geçtiyse doldurma)
        if first_surah == state.last_surah:
            gap = first_ayah - state.last_ayah - 1
            if 0 < gap <= MAX_GAP_FILL:
                # Atlanan ayetleri başa ekle
                filled = [(state.last_surah, state.last_ayah + i + 1)
                          for i in range(gap)]
                verses = filled + verses
                result["gap_filled"] = gap

    result["status"] = "matched"
    result["verses"] = [build_verse_payload(s, a) for s, a in verses]

    # Session state güncelle — son kelime pozisyonunu kaydet
    state.last_word_index = match.end_word_idx
    if verses:
        state.last_surah, state.last_ayah = verses[-1]
    state.lost_chunks = 0
    state.matched_chunks += 1

    return result

